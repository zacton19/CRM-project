{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Functions and *.test.ts files run on Deno and are checked by `npm test`.
  "exclude": ["node_modules", "supabase/functions", "**/*.test.ts"]
}
