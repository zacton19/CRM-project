# Copy to supabase/functions/.env for `npx supabase functions serve`.
# In production set it with: npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Never commit the real key. supabase/functions/.env is in .gitignore.
ANTHROPIC_API_KEY=

# Optional overrides (defaults are in supabase/functions/_shared/config.ts)
# CLAUDE_SUMMARY_MODEL=claude-sonnet-5-5
# CLAUDE_SEARCH_MODEL=claude-sonnet-5-5
# CLAUDE_SCORING_MODEL=claude-haiku-5-5
